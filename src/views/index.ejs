<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reserva de Salas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <h1 class="mb-4">Formulario de Reserva de Salas</h1>

    <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/reservas" method="POST" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label for="sala" class="form-label">Nombre de la Sala:</label>
            <input type="text" class="form-control" id="sala" name="sala" required>
        </div>
        <div class="mb-3">
            <label for="responsable" class="form-label">Responsable:</label>
            <input type="text" class="form-control" id="responsable" name="responsable" required>
        </div>
        <div class="mb-3">
            <label for="capacidad" class="form-label">Capacidad:</label>
            <input type="number" class="form-control" id="capacidad" name="capacidad" required>
        </div>
        <button type="submit" class="btn btn-primary">Registrar Reserva</button>
    </form>
    
    <div class="mt-3">
        <a href="/estado" class="btn btn-secondary">Ver Estado de Reservas</a>
    </div>
</body>
</html>