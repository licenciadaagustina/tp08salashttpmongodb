<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Reservas de Salas</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container my-5">
        <h1 class="mb-4">Formulario de Reserva de Salas</h1>

        <!-- Mensaje de error seguro (controlado) -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <!-- Formulario de reserva -->
        <div class="card mb-5 shadow-sm">
            <div class="card-body">
                <form action="/reservas" method="POST">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="estudiante" class="form-label">Estudiante</label>
                            <input type="text" class="form-control" id="estudiante" name="estudiante" required>
                        </div>
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="col-md-4">
                            <label for="sala" class="form-label">Sala</label>
                            <input type="text" class="form-control" id="sala" name="sala" required>
                        </div>
                        <div class="col-md-4">
                            <label for="fecha" class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="fecha" name="fecha" required>
                        </div>
                        <div class="col-md-4">
                            <label for="turno" class="form-label">Turno</label>
                            <select class="form-select" id="turno" name="turno" required>
                                <option value="" selected disabled>Seleccionar turno</option>
                                <option value="Mañana">Mañana</option>
                                <option value="Tarde">Tarde</option>
                                <option value="Noche">Noche</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="personas" class="form-label">Personas (1-6)</label>
                            <input type="number" class="form-control" id="personas" name="personas" min="1" max="6" required>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-4">Guardar Reserva</button>
                </form>
            </div>
        </div>

        <!-- Lista de reservas -->
        <h2 class="mb-3">Reservas Registradas</h2>
        <div class="table-responsive bg-white shadow-sm rounded">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Estudiante</th>
                        <th>Email</th>
                        <th>Sala</th>
                        <th>Fecha</th>
                        <th>Turno</th>
                        <th>Personas</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof reservas !== 'undefined' && reservas.length > 0) { %>
                        <% reservas.forEach(reserva => { %>
                            <tr>
                                <td><%= reserva.estudiante %></td>
                                <td><%= reserva.email %></td>
                                <td><%= reserva.sala %></td>
                                <td><%= reserva.fecha %></td>
                                <td><%= reserva.turno %></td>
                                <td><%= reserva.personas %></td>
                                <td><span class="badge bg-success"><%= reserva.estado || 'pendiente' %></span></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-3 text-muted">No hay reservas registradas.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>