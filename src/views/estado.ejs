<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Estado de Reservas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="container mt-5">
    <h1 class="mb-4">Listado de Reservas (MongoDB)</h1>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Sala</th>
                <th>Responsable</th>
                <th>Capacidad</th>
            </tr>
        </thead>
        <tbody>
            <% if (reservas && reservas.length > 0) { %>
                <% reservas.forEach(reserva => { %>
                    <tr>
                        <td><%= reserva.sala %></td>
                        <td><%= reserva.responsable %></td>
                        <td><%= reserva.capacidad %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="3" class="text-center">No hay reservas registradas todavía.</td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <a href="/" class="btn btn-primary">Hacer otra reserva</a>
</body>
</html>